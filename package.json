{
  "name": "@masculinecache/wrangler-axi",
  "version": "0.1.0",
  "description": "Agent-ergonomic TOON wrapper around Cloudflare Wrangler 4.x",
  "type": "module",
  "bin": {
    "wrangler-axi": "dist/bin/wrangler-axi.js"
  },
  "files": [
    "dist",
    "!dist/test",
    "skills/wrangler-axi",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
